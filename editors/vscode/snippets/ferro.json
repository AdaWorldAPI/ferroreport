{
  "Report": {
    "prefix": "report",
    "body": [
      "report \"${1:Title}\" lang=${2:en}",
      "  style Base default fontName=\"DejaVu Sans\" size=10",
      "",
      "  title gap=6",
      "    h1 height=26 size=16 : ${1:Title}",
      "  detail",
      "    text : {${3:name}}",
      "$0"
    ],
    "description": "A new report"
  },
  "Text": {
    "prefix": "text",
    "body": ["text ${1:1fr} : ${2:Label} {${3:field}}$0"],
    "description": "A text: static, or with {field} holes filled from the data"
  },
  "Formula": {
    "prefix": "text=",
    "body": ["text ${1:1fr} align=right pattern=${2:#,##0.00} : ={${3:qty}} * {${4:price}}$0"],
    "description": "A text whose value is an expression"
  },
  "Field": {
    "prefix": "field",
    "body": ["field ${1:name} ${2|String,Integer,Long,Double,BigDecimal,Boolean,Date,List|}$0"],
    "description": "A field and its class (for numbers, dates and conditions; other fields need no declaration)"
  },
  "Row": {
    "prefix": "row",
    "body": ["row height=${1:16}", "  text ${2:1fr} : $3", "  text ${4:1fr} align=right : $0"],
    "description": "Parts side by side"
  },
  "If": {
    "prefix": "if",
    "body": ["if : ${1:{field\\} != null}", "  $0"],
    "description": "Parts printed only when the condition holds"
  },
  "Each": {
    "prefix": "each",
    "body": ["each : {${1:lines}}", "  text : {${2:name}}$0"],
    "description": "Parts repeated for every row of a nested list"
  },
  "Definition": {
    "prefix": "def",
    "body": ["def ${1:money} ${2:value}", "  textField pattern=#,##0.00 hTextAlign=Right : {{${2:value}}}$0"],
    "description": "A definition to use again"
  },
  "Use": {
    "prefix": "use",
    "body": ["use ${1:money} ${2:1fr} ${3:value}=${4:{amount\\}}$0"],
    "description": "Use a definition"
  },
  "Import": {
    "prefix": "import",
    "body": ["import \"${1:parts.ferro}\"$0"],
    "description": "Bring in another file's definitions and styles"
  }
}
