<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Groovy" language="groovy" pageWidth="595" pageHeight="842" topMargin="20" rightMargin="20" bottomMargin="20" leftMargin="20" columnWidth="555">
	<field name="lines" class="java.util.List"/>
	<field name="name" class="java.lang.String"/>
	<detail>
		<band height="40">
			<element kind="textField" x="0" y="0" width="200" height="20">
				<expression><![CDATA[$F{lines}.collect({it}).size()]]></expression>
			</element>
			<element kind="textField" x="0" y="20" width="200" height="20">
				<expression><![CDATA[[{name}].size() + $F{name}]]></expression>
			</element>
		</band>
	</detail>
</jasperReport>
