<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="AutoIncrementStyles" pageWidth="400" pageHeight="330" columnWidth="360" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<!-- Styles without a parent take what they do not set from the default style. -->
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8"/>
	<style name="Bold" isBold="true"/>
	<style name="Tag" isItalic="true" forecolor="#AA0000"/>
	<field name="country" class="java.lang.String"/>
	<field name="city" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<!-- Never reset: just the value of its expression for the row at hand. -->
	<variable name="Letter" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$F{country}.substring(0, 1).toUpperCase()]]></variableExpression>
	</variable>
	<!-- Counts countries, not rows: it moves once per Country group. -->
	<variable name="Countries" class="java.lang.Integer" incrementType="Group" incrementGroup="Country" calculation="Count">
		<variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
	</variable>
	<variable name="CountrySum" class="java.lang.Double" resetType="Group" resetGroup="Country" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="PairSum" class="java.lang.Double" resetType="Group" resetGroup="Pair" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="Total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<!-- A group whose expression reads a variable: a new block every two countries. -->
	<group name="Pair">
		<groupExpression><![CDATA[($V{Countries} - 1) / 2]]></groupExpression>
		<groupHeader>
			<band height="14">
				<staticText>
					<reportElement style="Bold" mode="Opaque" x="0" y="0" width="120" height="11" forecolor="#FFFFFF" backcolor="#333333"/>
					<text><![CDATA[Block starting at]]></text>
				</staticText>
				<textField>
					<reportElement style="Bold" mode="Opaque" x="120" y="0" width="30" height="11" forecolor="#FFFFFF" backcolor="#333333"/>
					<textFieldExpression><![CDATA[$V{Letter}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Auto">
					<reportElement style="Tag" x="150" y="0" width="210" height="11"/>
					<textElement textAlignment="Right"/>
					<textFieldExpression><![CDATA[msg("{0,number,0.0}% of {1,number,#,##0.00}", 100d * $V{PairSum} / $V{Total}, $V{Total})]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<group name="Country">
		<groupExpression><![CDATA[$F{country}]]></groupExpression>
		<groupHeader>
			<band height="13">
				<textField>
					<reportElement style="Bold" x="0" y="1" width="150" height="11"/>
					<textFieldExpression><![CDATA[$V{Countries} + ". " + $F{country}]]></textFieldExpression>
				</textField>
				<textField evaluationTime="Auto">
					<reportElement style="Tag" x="150" y="1" width="210" height="11"/>
					<textElement textAlignment="Right"/>
					<textFieldExpression><![CDATA[msg("{0} has {1,number,0.00}, {2,number,0.0}% of its block", $V{Letter}, $V{CountrySum}, 100d * $V{CountrySum} / $V{PairSum})]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
	</group>
	<detail>
		<band height="12">
			<textField>
				<reportElement x="10" y="0" width="200" height="11"/>
				<textFieldExpression><![CDATA[$F{city}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00">
				<reportElement x="260" y="0" width="100" height="11"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="14">
			<textField>
				<reportElement style="Bold" x="0" y="2" width="360" height="11"/>
				<textFieldExpression><![CDATA[msg("{0} countries, {1} rows, {2,number,#,##0.00} in all", $V{Countries}, $V{REPORT_COUNT}, $V{Total})]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
