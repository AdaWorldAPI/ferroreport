<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="orders" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
	<style name="B" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
	<field name="order" class="java.lang.String"/>
	<field name="customer" class="java.lang.String"/>
	<field name="lines" class="java.util.List"/>
	<variable name="order_total" class="java.lang.Double" calculation="System"/>
	<variable name="grand_total" class="java.lang.Double" calculation="Sum"><variableExpression><![CDATA[$V{order_total}]]></variableExpression></variable>
	<title><band height="30"><staticText><reportElement x="0" y="0" width="515" height="24"/><textElement><font size="16" isBold="true"/></textElement><text><![CDATA[Orders with line items]]></text></staticText></band></title>
	<pageHeader><band height="14"><textField><reportElement x="0" y="0" width="515" height="12" forecolor="#999999"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageHeader>
	<detail>
		<band height="22">
			<textField><reportElement mode="Opaque" x="0" y="4" width="515" height="16" forecolor="#FFFFFF" backcolor="#2B4C7E"/><box leftPadding="4"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{order} + " - " + $F{customer} + " (" + $F{lines}.size() + " lines)"]]></textFieldExpression></textField>
		</band>
		<band height="20">
			<subreport>
				<reportElement x="0" y="2" width="515" height="16"/>
				<subreportParameter name="CURRENCY"><subreportParameterExpression><![CDATA["DOP"]]></subreportParameterExpression></subreportParameter>
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{lines})]]></dataSourceExpression>
				<returnValue subreportVariable="total" toVariable="order_total"/>
				<subreportExpression><![CDATA["lines.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<summary><band height="24">
		<textField pattern="#,##0.00"><reportElement x="265" y="6" width="250" height="16"/><textElement textAlignment="Right"><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Grand total DOP " + new java.text.DecimalFormat("#,##0.00").format($V{grand_total})]]></textFieldExpression></textField>
	</band></summary>
</jasperReport>
