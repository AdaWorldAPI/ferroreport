<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="overflow_cells" pageWidth="595" pageHeight="500" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<style name="B" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
	<style name="Cell" style="B"><box topPadding="2" leftPadding="3" bottomPadding="2" rightPadding="3"><pen lineWidth="0.5" lineColor="#7F8C8D"/></box></style>
	<field name="code" class="java.lang.String"/>
	<field name="note" class="java.lang.String"/>
	<field name="amount" class="java.lang.Double"/>
	<pageHeader><band height="18"><textField><reportElement x="0" y="0" width="555" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageHeader>
	<columnHeader><band height="16">
		<staticText><reportElement style="Cell" mode="Opaque" x="0" y="0" width="70" height="16" backcolor="#D6EAF8"/><text><![CDATA[Code]]></text></staticText>
		<staticText><reportElement style="Cell" mode="Opaque" x="70" y="0" width="385" height="16" backcolor="#D6EAF8"/><text><![CDATA[Note]]></text></staticText>
		<staticText><reportElement style="Cell" mode="Opaque" x="455" y="0" width="100" height="16" backcolor="#D6EAF8"/><textElement textAlignment="Right"/><text><![CDATA[Amount]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16">
		<textField><reportElement style="Cell" stretchType="RelativeToBandHeight" x="0" y="0" width="70" height="16" isPrintWhenDetailOverflows="true"/><textFieldExpression><![CDATA[$F{code}]]></textFieldExpression></textField>
		<textField isStretchWithOverflow="true"><reportElement style="Cell" x="70" y="0" width="385" height="16"/><textFieldExpression><![CDATA[$F{note}]]></textFieldExpression></textField>
		<textField pattern="#,##0.00"><reportElement style="Cell" stretchType="RelativeToBandHeight" x="455" y="0" width="100" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
	</band></detail>
	<pageFooter><band height="16"><staticText><reportElement x="0" y="2" width="555" height="14" forecolor="#999999"/><text><![CDATA[Statement of account]]></text></staticText></band></pageFooter>
</jasperReport>