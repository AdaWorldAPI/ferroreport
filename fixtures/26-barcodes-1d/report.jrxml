<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" name="barcodes_1d" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
	<style name="B" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
	<field name="product" class="java.lang.String"/>
	<field name="ean" class="java.lang.String"/>
	<field name="upc" class="java.lang.String"/>
	<field name="sku" class="java.lang.String"/>
	<field name="box" class="java.lang.String"/>
	<title>
		<band height="30"><staticText><reportElement x="0" y="0" width="515" height="20"/><textElement><font size="14" isBold="true"/></textElement><text><![CDATA[Product labels]]></text></staticText></band>
	</title>
	<detail>
		<band height="160">
			<textField><reportElement x="0" y="0" width="515" height="14"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{product}]]></textFieldExpression></textField>
			<componentElement>
				<reportElement x="0" y="20" width="150" height="70"/>
				<jr:EAN13><jr:codeExpression><![CDATA[$F{ean}]]></jr:codeExpression></jr:EAN13>
			</componentElement>
			<componentElement>
				<reportElement x="170" y="20" width="150" height="70"/>
				<jr:UPCA moduleWidth="1.1" textPosition="top"><jr:codeExpression><![CDATA[$F{upc}]]></jr:codeExpression></jr:UPCA>
			</componentElement>
			<componentElement>
				<reportElement x="340" y="20" width="110" height="60"/>
				<jr:EAN8><jr:codeExpression><![CDATA[$F{ean}.substring(0, 7)]]></jr:codeExpression></jr:EAN8>
			</componentElement>
			<componentElement>
				<reportElement style="B" x="0" y="100" width="220" height="50"/>
				<jr:Code39 checksumMode="add" displayChecksum="true" displayStartStop="false"><jr:codeExpression><![CDATA[$F{sku}]]></jr:codeExpression></jr:Code39>
			</componentElement>
			<componentElement>
				<reportElement x="240" y="100" width="150" height="50"/>
				<jr:Interleaved2Of5 checksumMode="add" displayChecksum="true" wideFactor="2.5"><jr:codeExpression><![CDATA[$F{box}]]></jr:codeExpression></jr:Interleaved2Of5>
			</componentElement>
			<componentElement>
				<reportElement x="400" y="100" width="115" height="50"/>
				<jr:Codabar textPosition="none"><jr:codeExpression><![CDATA["a" + $F{box} + "b"]]></jr:codeExpression></jr:Codabar>
			</componentElement>
		</band>
	</detail>
</jasperReport>
