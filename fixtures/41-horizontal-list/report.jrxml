<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" name="HorizontalList" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8"/>
	<subDataset name="contacts">
		<field name="name" class="java.lang.String"/>
		<field name="role" class="java.lang.String"/>
		<field name="note" class="java.lang.String"/>
		<variable name="n" class="java.lang.Integer" calculation="Count">
			<variableExpression><![CDATA[$F{name}]]></variableExpression>
		</variable>
	</subDataset>
	<field name="customer" class="java.lang.String"/>
	<field name="contacts" class="java.util.List"/>
	<detail>
		<band height="80">
			<textField><reportElement mode="Opaque" x="0" y="0" width="515" height="16" backcolor="#E0E0E0"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression></textField>
			<componentElement>
				<reportElement positionType="Float" x="0" y="20" width="515" height="50"/>
				<!-- Contacts side by side: as many 160-point cards to a row as fit in 515 points. -->
				<jr:list printOrder="Horizontal">
					<datasetRun subDataset="contacts">
						<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{contacts})]]></dataSourceExpression>
					</datasetRun>
					<jr:listContents height="50" width="160">
						<rectangle><reportElement stretchType="RelativeToBandHeight" x="2" y="2" width="154" height="44"/></rectangle>
						<textField><reportElement x="8" y="4" width="144" height="12"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$V{n} + ". " + $F{name}]]></textFieldExpression></textField>
						<textField><reportElement x="8" y="16" width="144" height="11"/><textElement><font isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{role}]]></textFieldExpression></textField>
						<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement positionType="Float" x="8" y="28" width="144" height="11"/><textFieldExpression><![CDATA[$F{note}]]></textFieldExpression></textField>
					</jr:listContents>
				</jr:list>
			</componentElement>
		</band>
	</detail>
</jasperReport>
