<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="charts_xy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
	<style name="B" isDefault="true" fontName="DejaVu Sans" fontSize="8"/>
	<field name="branch" class="java.lang.String"/>
	<field name="day" class="java.lang.Integer"/>
	<field name="orders" class="java.lang.Integer"/>
	<field name="amount" class="java.lang.Double"/>
	<group name="branch">
		<groupExpression><![CDATA[$F{branch}]]></groupExpression>
		<groupHeader><band height="18"><textField><reportElement x="0" y="2" width="535" height="14"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Branch " + $F{branch}]]></textFieldExpression></textField></band></groupHeader>
		<groupFooter><band height="190">
			<xyLineChart>
				<chart evaluationTime="Group" evaluationGroup="branch">
					<reportElement x="0" y="0" width="265" height="180"/>
					<chartTitle><titleExpression><![CDATA["Amount per day — " + $F{branch}]]></titleExpression></chartTitle>
				</chart>
				<xyDataset>
					<dataset resetType="Group" resetGroup="branch"/>
					<xySeries><seriesExpression><![CDATA["Amount"]]></seriesExpression><xValueExpression><![CDATA[$F{day}]]></xValueExpression><yValueExpression><![CDATA[$F{amount}]]></yValueExpression></xySeries>
				</xyDataset>
				<linePlot><plot/><categoryAxisLabelExpression><![CDATA["Day"]]></categoryAxisLabelExpression><valueAxisLabelExpression><![CDATA["RD$"]]></valueAxisLabelExpression></linePlot>
			</xyLineChart>
			<scatterChart>
				<chart evaluationTime="Group" evaluationGroup="branch">
					<reportElement x="270" y="0" width="265" height="180"/>
					<chartTitle><titleExpression><![CDATA["Orders vs amount"]]></titleExpression></chartTitle>
				</chart>
				<xyDataset>
					<dataset resetType="Group" resetGroup="branch"/>
					<xySeries><seriesExpression><![CDATA[$F{branch}]]></seriesExpression><xValueExpression><![CDATA[$F{orders}]]></xValueExpression><yValueExpression><![CDATA[$F{amount}]]></yValueExpression></xySeries>
				</xyDataset>
				<scatterPlot><plot/></scatterPlot>
			</scatterChart>
		</band></groupFooter>
	</group>
	<detail><band height="0"/></detail>
</jasperReport>
