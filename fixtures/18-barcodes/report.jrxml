<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" name="barcodes" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
	<style name="B" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
	<field name="ecf" class="java.lang.String"/>
	<field name="rnc" class="java.lang.String"/>
	<field name="amount" class="java.lang.String"/>
	<field name="sku" class="java.lang.String"/>
	<detail>
		<band height="140">
			<textField><reportElement x="0" y="0" width="300" height="14"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA["e-CF " + $F{ecf} + "  RNC " + $F{rnc}]]></textFieldExpression></textField>
			<componentElement>
				<reportElement x="0" y="18" width="100" height="100"/>
				<jr:QRCode errorCorrectionLevel="M" margin="0">
					<jr:codeExpression><![CDATA["https://ecf.dgii.gov.do/ecf/ConsultaTimbre?RncEmisor=" + $F{rnc} + "&ENCF=" + $F{ecf} + "&MontoTotal=" + $F{amount} + "&CodigoSeguridad=Ab12Cd"]]></jr:codeExpression>
				</jr:QRCode>
			</componentElement>
			<componentElement>
				<reportElement x="120" y="18" width="60" height="60"/>
				<jr:QRCode errorCorrectionLevel="H">
					<jr:codeExpression><![CDATA[$F{ecf}]]></jr:codeExpression>
				</jr:QRCode>
			</componentElement>
			<componentElement>
				<reportElement x="200" y="18" width="200" height="50"/>
				<jr:Code128 moduleWidth="1.0" textPosition="none">
					<jr:codeExpression><![CDATA[$F{sku}]]></jr:codeExpression>
				</jr:Code128>
			</componentElement>
			<componentElement>
				<reportElement x="200" y="74" width="200" height="40" forecolor="#336699"/>
				<jr:Code128 moduleWidth="0.75">
					<jr:codeExpression><![CDATA[$F{sku}]]></jr:codeExpression>
				</jr:Code128>
			</componentElement>
		</band>
	</detail>
</jasperReport>
