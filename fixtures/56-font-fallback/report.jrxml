<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="font-fallback" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">
	<!-- "Serif Fallback" and "Mono Fallback" are font sets (fontsets.txt, jasper-extension/):
	     DejaVu Serif lacks the stars, check marks and circled digits that DejaVu Sans has. -->
	<style name="Base" isDefault="true" fontName="Serif Fallback" fontSize="11"/>
	<field name="product" class="java.lang.String"/>
	<field name="rating" class="java.lang.String"/>
	<field name="note" class="java.lang.String"/>
	<title>
		<band height="300">
			<staticText>
				<reportElement x="0" y="0" width="515" height="26"/>
				<textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
				<text><![CDATA[Customer ratings ★ spring catalogue]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="34" width="515" height="30"/>
				<text><![CDATA[Every character of this line is in DejaVu Serif, the primary family of the set, so it is drawn in DejaVu Serif alone.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="72" width="250" height="100"/>
				<box padding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[The run that needs DejaVu Sans goes on until a character it lacks: here the arrow ⤴ that only DejaVu Serif has, so this sentence switches fonts ★ twice and wraps over several lines in a justified box.]]></text>
			</staticText>
			<staticText>
				<reportElement x="265" y="72" width="250" height="60"/>
				<box padding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Right"><font isItalic="true"/></textElement>
				<text><![CDATA[Italic, right aligned: ☂ umbrella
and a second paragraph ✓]]></text>
			</staticText>
			<staticText>
				<reportElement x="265" y="145" width="250" height="20"/>
				<textElement textAlignment="Center"><font fontName="Mono Fallback" size="10"/></textElement>
				<text><![CDATA[APL ⍟ in mono, ⤴ in serif, ① in sans]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="190" width="250" height="40"/>
				<textElement markup="styled"/>
				<text><![CDATA[Styled: <style isBold="true">bold ✈ flight</style>, <style forecolor="#AA0000">red ★ star</style> and plain ⤵ serif.]]></text>
			</staticText>
			<staticText>
				<reportElement x="265" y="190" width="250" height="20"/>
				<textElement><font fontName="DejaVu Serif"/></textElement>
				<text><![CDATA[Plain DejaVu Serif, not a set: ok.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="270" width="515" height="22"/>
				<box><bottomPen lineWidth="1"/></box>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Product                         Rating                Note]]></text>
			</staticText>
		</band>
	</title>
	<detail>
		<band height="20">
			<textField>
				<reportElement x="0" y="2" width="170" height="16"/>
				<textFieldExpression><![CDATA[$F{product}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="170" y="2" width="110" height="16"/>
				<textElement><font size="13"/></textElement>
				<textFieldExpression><![CDATA[$F{rating}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="280" y="2" width="235" height="16"/>
				<textFieldExpression><![CDATA[$F{note}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
