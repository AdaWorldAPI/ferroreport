<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="empty_result" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10"/>
	<parameter name="SEARCH" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<title><band height="30"><staticText><reportElement x="0" y="0" width="555" height="30"/><text><![CDATA[Not printed]]></text></staticText></band></title>
	<detail><band height="20"><textField><reportElement x="0" y="0" width="555" height="20"/><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField></band></detail>
	<noData>
		<band height="80">
			<rectangle radius="10">
				<reportElement mode="Opaque" x="80" y="10" width="395" height="60" backcolor="#FFF4E5" forecolor="#E0A040"/>
			</rectangle>
			<textField>
				<reportElement x="90" y="20" width="375" height="40"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="12"/></textElement>
				<textFieldExpression><![CDATA["No records match the filter \"" + $P{SEARCH} + "\"."]]></textFieldExpression>
			</textField>
		</band>
	</noData>
</jasperReport>
