<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" name="customer_contacts" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
	<subDataset name="contacts">
		<parameter name="ACCENT" class="java.lang.String"/>
		<field name="name" class="java.lang.String"/>
		<field name="role" class="java.lang.String"/>
		<field name="phone" class="java.lang.String"/>
		<field name="note" class="java.lang.String"/>
		<variable name="n" class="java.lang.Integer" calculation="Count">
			<variableExpression><![CDATA[$F{name}]]></variableExpression>
		</variable>
	</subDataset>
	<field name="customer" class="java.lang.String"/>
	<field name="city" class="java.lang.String"/>
	<field name="contacts" class="java.util.List"/>
	<detail>
		<band height="90">
			<rectangle><reportElement x="0" y="0" width="515" height="22" backcolor="#283618"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
			<textField><reportElement x="8" y="0" width="400" height="22" forecolor="#FEFAE0"/><textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression></textField>
			<textField><reportElement x="400" y="0" width="107" height="22" forecolor="#DDA15E"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{city}]]></textFieldExpression></textField>
			<componentElement>
				<reportElement x="10" y="28" width="505" height="48"/>
				<jr:list printOrder="Vertical">
					<datasetRun subDataset="contacts">
						<datasetParameter name="ACCENT"><datasetParameterExpression><![CDATA["#BC6C25"]]></datasetParameterExpression></datasetParameter>
						<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{contacts})]]></dataSourceExpression>
					</datasetRun>
					<jr:listContents height="48" width="505">
						<rectangle><reportElement x="0" y="2" width="4" height="40" backcolor="#BC6C25"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
						<textField><reportElement x="12" y="2" width="20" height="14"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$V{n} + "."]]></textFieldExpression></textField>
						<textField><reportElement x="32" y="2" width="240" height="14"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
						<textField><reportElement x="280" y="2" width="225" height="14" forecolor="#606C38"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{phone}]]></textFieldExpression></textField>
						<textField><reportElement x="32" y="16" width="473" height="12" forecolor="#555555"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{role}]]></textFieldExpression></textField>
						<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement positionType="Float" x="32" y="28" width="473" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{note}]]></textFieldExpression></textField>
