<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="columns" pageWidth="595" pageHeight="842" columnCount="3" columnWidth="165" columnSpacing="10" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
	<style name="B" isDefault="true" fontName="DejaVu Sans" fontSize="8"/>
	<field name="city" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="phone" class="java.lang.String"/>
	<variable name="city_count" class="java.lang.Integer" resetType="Group" resetGroup="city" calculation="Count"><variableExpression><![CDATA[$F{name}]]></variableExpression></variable>
	<group name="city">
		<groupExpression><![CDATA[$F{city}]]></groupExpression>
		<groupHeader><band height="18">
			<textField><reportElement mode="Opaque" x="0" y="2" width="165" height="14" backcolor="#DDE6F0"/><box leftPadding="3"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{city}]]></textFieldExpression></textField>
		</band></groupHeader>
		<groupFooter><band height="14">
			<textField><reportElement x="0" y="0" width="165" height="12"/><textElement textAlignment="Right"><font isItalic="true"/></textElement><textFieldExpression><![CDATA[$V{city_count} + " contacts"]]></textFieldExpression></textField>
		</band></groupFooter>
	</group>
	<title><band height="30"><staticText><reportElement x="0" y="0" width="535" height="24"/><textElement><font size="16" isBold="true"/></textElement><text><![CDATA[Contact directory]]></text></staticText></band></title>
	<pageHeader><band height="14"><textField><reportElement x="0" y="0" width="535" height="12"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageHeader>
	<columnHeader><band height="16">
		<textField><reportElement mode="Opaque" x="0" y="0" width="165" height="14" forecolor="#FFFFFF" backcolor="#2B4C7E"/><box leftPadding="3"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA["Name / phone — col " + $V{COLUMN_NUMBER}]]></textFieldExpression></textField>
	</band></columnHeader>
	<detail><band height="24">
		<textField><reportElement x="3" y="1" width="162" height="11"/><textFieldExpression><![CDATA[$V{REPORT_COUNT} + ". " + $F{name}]]></textFieldExpression></textField>
		<textField><reportElement x="3" y="12" width="162" height="11" forecolor="#666666"/><textFieldExpression><![CDATA[$F{phone} + "  (" + $V{COLUMN_COUNT} + ")"]]></textFieldExpression></textField>
	</band></detail>
	<columnFooter><band height="14"><textField><reportElement x="0" y="0" width="165" height="12" forecolor="#999999"/><textFieldExpression><![CDATA["end of column " + $V{COLUMN_NUMBER}]]></textFieldExpression></textField></band></columnFooter>
	<pageFooter><band height="16"><textField><reportElement x="0" y="2" width="535" height="12"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA["Footer page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
	<summary><band height="20"><textField><reportElement x="0" y="4" width="535" height="14"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA["Total contacts: " + $V{REPORT_COUNT}]]></textFieldExpression></textField></band></summary>
</jasperReport>
