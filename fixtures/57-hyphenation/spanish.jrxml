<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" name="spanish" pageWidth="120" pageHeight="180" columnWidth="120" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="AllSectionsNoDetail">
	<property name="ferroreport.text.hyphenate" value="es"/>
	<title>
		<band height="180">
			<staticText>
				<reportElement x="0" y="0" width="120" height="180"/>
				<box padding="4"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Justified"><font fontName="DejaVu Serif" size="10"/></textElement>
				<text><![CDATA[La responsabilidad administrativa de la internacionalización exige documentación extraordinariamente cuidadosa y comprensible.]]></text>
			</staticText>
		</band>
	</title>
</jasperReport>
