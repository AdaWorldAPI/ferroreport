<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sales_by_region" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8"/>
	<field name="region" class="java.lang.String"/>
	<field name="city" class="java.lang.String"/>
	<field name="seller" class="java.lang.String"/>
	<field name="date" class="java.util.Date"/>
	<field name="amount" class="java.lang.Double"/>
	<variable name="region_total" class="java.lang.Double" resetType="Group" resetGroup="region" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="city_total" class="java.lang.Double" resetType="Group" resetGroup="city" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="city_avg" class="java.lang.Double" resetType="Group" resetGroup="city" calculation="Average">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="page_total" class="java.lang.Double" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="grand_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="max_sale" class="java.lang.Double" calculation="Highest">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="sellers" class="java.lang.Integer" calculation="DistinctCount">
		<variableExpression><![CDATA[$F{seller}]]></variableExpression>
	</variable>
	<group name="region">
		<groupExpression><![CDATA[$F{region}]]></groupExpression>
		<groupHeader>
			<band height="26">
				<textField>
					<reportElement mode="Opaque" x="0" y="4" width="535" height="20" forecolor="#FFFFFF" backcolor="#1F6F5C"/>
					<box leftPadding="6"/>
					<textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Region: " + $F{region}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="24">
				<textField>
					<reportElement x="235" y="4" width="200" height="16"/>
					<textElement textAlignment="Right"><font isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Total " + $F{region} + " (" + $V{region_COUNT} + " sales)"]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0.00">
					<reportElement x="435" y="4" width="100" height="16"/>
					<box><topPen lineWidth="1.0"/></box>
					<textElement textAlignment="Right"><font isBold="true"/></textElement>
					<textFieldExpression><![CDATA[$V{region_total}]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
	<group name="city">
		<groupExpression><![CDATA[$F{city}]]></groupExpression>
		<groupHeader>
			<band height="18">
				<textField>
					<reportElement x="10" y="2" width="300" height="14" forecolor="#1F6F5C"/>
					<textElement><font size="9" isBold="true" isUnderline="true"/></textElement>
					<textFieldExpression><![CDATA[$F{city}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="16">
				<textField pattern="#,##0.00">
					<reportElement x="235" y="0" width="200" height="14" forecolor="#666666"/>
					<textElement textAlignment="Right"/>
					<textFieldExpression><![CDATA["avg " + new java.text.DecimalFormat("#,##0.00").format($V{city_avg}) + "  subtotal"]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0.00">
					<reportElement x="435" y="0" width="100" height="14"/>
					<textElement textAlignment="Right"/>
					<textFieldExpression><![CDATA[$V{city_total}]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
	<title>
		<band height="40">
			<staticText>
				<reportElement x="0" y="0" width="535" height="24"/>
				<textElement><font size="16" isBold="true"/></textElement>
				<text><![CDATA[Sales by region]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="24" width="535" height="14" forecolor="#777777"/>
				<text><![CDATA[Fiscal year 2026 - all amounts in DOP]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band height="16">
			<textField>
				<reportElement x="335" y="0" width="200" height="14" forecolor="#999999"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Sales by region - page " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>
	<columnHeader>
		<band height="16">
			<staticText>
				<reportElement x="20" y="0" width="150" height="14"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Seller]]></text>
			</staticText>
			<staticText>
				<reportElement x="170" y="0" width="100" height="14"/>
				<textElement><font isBold="true"/></textElement>
				<text><![CDATA[Date]]></text>
			</staticText>
			<staticText>
				<reportElement x="435" y="0" width="100" height="14"/>
				<textElement textAlignment="Right"><font isBold="true"/></textElement>
				<text><![CDATA[Amount]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="15" width="535" height="1"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>
		</band>
	</columnHeader>
	<detail>
		<band height="13">
			<frame>
				<reportElement mode="Opaque" x="0" y="0" width="535" height="13" backcolor="#F1F6F4">
					<printWhenExpression><![CDATA[$V{city_COUNT} % 2 == 0]]></printWhenExpression>
				</reportElement>
			</frame>
			<textField>
				<reportElement x="20" y="0" width="150" height="13"/>
				<textFieldExpression><![CDATA[$F{seller}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="170" y="0" width="100" height="13"/>
				<textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00">
				<reportElement x="435" y="0" width="100" height="13"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="18">
			<textField pattern="#,##0.00">
				<reportElement x="235" y="2" width="300" height="14"/>
				<textElement textAlignment="Right"><font isItalic="true"/></textElement>
				<textFieldExpression><![CDATA["Page total: " + new java.text.DecimalFormat("#,##0.00").format($V{page_total} == null ? 0.0 : $V{page_total})]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="60">
			<rectangle>
				<reportElement x="235" y="10" width="300" height="46" forecolor="#1F6F5C"/>
			</rectangle>
			<textField>
				<reportElement x="245" y="14" width="280" height="14"/>
				<textFieldExpression><![CDATA[$V{REPORT_COUNT} + " sales by " + $V{sellers} + " sellers"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="245" y="26" width="280" height="14"/>
				<textFieldExpression><![CDATA["Largest sale: " + new java.text.DecimalFormat("#,##0.00").format($V{max_sale})]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00">
				<reportElement x="245" y="38" width="280" height="16"/>
				<textElement textAlignment="Right"><font size="11" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$V{grand_total}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
