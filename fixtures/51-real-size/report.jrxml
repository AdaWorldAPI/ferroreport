<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="real-size" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
	<field name="label" class="java.lang.String"/>
	<field name="image" class="java.lang.String"/>
	<title>
		<band height="60">
			<image scaleImage="RealHeight">
				<reportElement mode="Opaque" x="0" y="0" width="300" height="40" backcolor="#DDEEFF"/>
				<box><pen lineWidth="0.5"/></box>
				<imageExpression><![CDATA["logo.png"]]></imageExpression>
			</image>
			<textField>
				<reportElement positionType="Float" x="0" y="44" width="300" height="14"/>
				<textFieldExpression><![CDATA["below a RealHeight logo (240x96) in 300x40"]]></textFieldExpression>
			</textField>
			<image scaleImage="RealSize" hAlign="Center">
				<reportElement mode="Opaque" x="310" y="0" width="205" height="20" backcolor="#FFEEDD"/>
				<box topPadding="4" leftPadding="2" bottomPadding="6"><pen lineWidth="0.5"/></box>
				<imageExpression><![CDATA["gray.png"]]></imageExpression>
			</image>
		</band>
	</title>
	<detail>
		<band height="50">
			<textField>
				<reportElement x="0" y="0" width="150" height="14"/>
				<textFieldExpression><![CDATA[$F{label}]]></textFieldExpression>
			</textField>
			<image scaleImage="RealHeight" hAlign="Right">
				<reportElement mode="Opaque" x="160" y="0" width="150" height="50" backcolor="#EEEEEE"/>
				<imageExpression><![CDATA[$F{image}]]></imageExpression>
			</image>
			<image scaleImage="RealSize" hAlign="Right">
				<reportElement mode="Opaque" x="320" y="0" width="195" height="30" backcolor="#EEFFEE"/>
				<box padding="3"><pen lineWidth="0.5"/></box>
				<imageExpression><![CDATA[$F{image}]]></imageExpression>
			</image>
			<textField>
				<reportElement positionType="Float" x="0" y="36" width="515" height="12"/>
				<textFieldExpression><![CDATA["after " + $F{label}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
