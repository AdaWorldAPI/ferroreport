{
  "name": "ferroreport",
  "version": "0.9.0",
  "description": "Report engine for Node.js, Deno, Bun and browsers: PDF, Excel (XLSX) and CSV in milliseconds. Reads JasperReports JRXML templates with pixel-identical output, no JVM, safe with untrusted templates.",
  "license": "MIT OR Apache-2.0",
  "author": "Cristian Encarnacion",
  "homepage": "https://cristianencarnacion.github.io/ferroreport/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianEncarnacion/ferroreport.git",
    "directory": "bindings/wasm"
  },
  "bugs": "https://github.com/cristianEncarnacion/ferroreport/issues",
  "keywords": ["jasperreports", "jrxml", "pdf", "excel", "xlsx", "csv", "report", "reporting", "invoice", "pdf-generation", "charts", "qrcode", "wasm", "fast"],
  "main": "./node/ferroreport.js",
  "types": "./node/ferroreport.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./node/ferroreport.d.ts",
        "default": "./node/ferroreport.js"
      },
      "default": {
        "types": "./web/ferroreport.d.ts",
        "default": "./web/ferroreport.js"
      }
    }
  },
  "files": ["node/", "web/", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": false,
  "engines": { "node": ">=18" }
}
